{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "NEXT_PUBLIC_API_URL=/api NEXT_PUBLIC_ISSUER_PORTAL_URL=/registry npm run build"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "apps.api.main:app",
      "bindings": [{ "type": "service", "service": "registry", "format": "url", "env": "REGISTRY_INTERNAL_URL" }],
      "buildCommand": "python scripts/prepare_ocr.py",
      "functions": {
        "apps/api/main.py": {
          "maxDuration": 300,
          "includeFiles": "{fixtures/**,apps/api/tessdata/**}"
        }
      },
      "rewrites": [{ "source": "/api/:path(.*)?", "destination": "/:path" }]
    },
    "registry": {
      "root": "apps/issuer-portal",
      "framework": "nextjs",
      "buildCommand": "NEXT_PUBLIC_REGISTRY_BASE_PATH=/registry npm run build"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "backend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/registry", "destination": { "service": "registry" } },
    { "source": "/registry/(.*)", "destination": { "service": "registry" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
