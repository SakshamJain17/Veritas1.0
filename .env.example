TINYFISH_API_KEY=
TINYFISH_SEARCH_BASE_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_BASE_URL=https://api.fetch.tinyfish.ai
TINYFISH_BROWSER_BASE_URL=https://api.browser.tinyfish.ai
TINYFISH_AGENT_BASE_URL=https://agent.tinyfish.ai/v1/automation
# Enable only if your TinyFish account has beta access to max_steps:
TINYFISH_BETA_STEP_LIMIT=false
# Public issuer homepage used only by the live smoke tests:
TINYFISH_LIVE_REGISTRY_URL=
VERITAS_DB_PATH=./data/veritas.db
# Optional PostgreSQL connection; overrides VERITAS_DB_PATH:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/veritas
VERITAS_UPLOAD_PATH=./uploads
UPLOAD_MAX_MB=15
ISSUER_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_ISSUER_PORTAL_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000
VERITAS_APPROVED_HOSTS=www.tinyfish.ai,docs.tinyfish.ai
VERITAS_WEB_ORIGIN=http://localhost:3000
VERITAS_ACCESS_KEY=
VERITAS_REVIEWER_KEY=
VERITAS_SESSION_SECRET=
VERITAS_COOKIE_SECURE=false
